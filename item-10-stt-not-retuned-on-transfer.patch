+    async def retune_stt_for(self, runtime: AgentRuntime) -> bool:
+        """Point the call's STT at ``runtime``'s own transcription settings.
+
+        ``build`` creates an ``llm`` and a ``tts`` per agent, but the STT is
+        created once per call in ``run_pipeline`` and lives in the *call*
+        pipeline, not in an agent's generation pipeline. So a destination's
+        ``stt.language`` and ``stt.language_hints`` never take effect on a
+        transferred call: the whole call keeps listening with the first agent's
+        transcriber, while ``runtime_configuration`` reports an STT that is not
+        the one running.
+
+        On ``flux-general-multi`` the hints are a Configure field, so they are
+        changed on the open socket and nothing reconnects. Reconnecting is not
+        a safe alternative: we tried ``_disconnect()``/``_connect()`` first and
+        it left the socket reporting "ready to stream audio" while producing no
+        transcripts at all for the rest of the call, which matches the
+        ``_receive_task`` hazard described in
+        ``pipecat/services/deepgram/flux/stt.py``.
+
+        Returns True when the hints actually changed.
+        """
+        stt = self._stt
+        settings = getattr(stt, "_settings", None)
+        # Only the multilingual Flux model honours language hints.
+        if settings is None or getattr(settings, "model", None) != "flux-general-multi":
+            return False
+        stt_config = getattr(getattr(runtime, "user_config", None), "stt", None)
+        if stt_config is None:
+            return False
+
+        # Same composition as `create_stt_service`: the main language first,
+        # then the hints, resolved and de-duplicated. Worth extracting into one
+        # shared helper there rather than keeping two copies in step by hand.
+        from api.services.pipecat.service_factory import (
+            _resolve_deepgram_flux_language_hint,
+        )
+
+        codes = [
+            getattr(stt_config, "language", None),
+            *(getattr(stt_config, "language_hints", None) or []),
+        ]
+        hints = list(
+            dict.fromkeys(
+                hint for hint in map(_resolve_deepgram_flux_language_hint, codes) if hint
+            )
+        )
+        changed = await stt._update_settings(type(settings)(language_hints=hints))
+        if changed:
+            logger.info(
+                f"[transfer] STT retuned for visit {runtime.visit_id}: "
+                f"language_hints={[getattr(h, 'value', h) for h in hints]}"
+            )
+        return bool(changed)
+
