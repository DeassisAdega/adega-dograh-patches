+async def _retune_stt(engine, runtime) -> None:
+    """Hand the call's STT over to ``runtime`` before it starts listening.
+
+    Called while the hold audio is still playing, which is the one moment in a
+    transfer where a settings change cannot land in the middle of a caller's
+    sentence. A failure here must not fail the transfer: a destination
