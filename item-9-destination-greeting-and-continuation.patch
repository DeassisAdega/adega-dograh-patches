+            # The destination introduces itself by TTS, not through the model.
+            #
+            # With play_greeting false the destination's opening is an LLM
+            # generation. Whenever that generation comes out as a tool call --
+            # and it does, every time the caller's first question needs a
+            # lookup -- the opening turn is consumed by the tool and the
+            # introduction is lost. Measured on real calls: 0 of 2 when the
+            # first turn in the new language queried the knowledge base,
+            # 9 of 9 when it did not.
+            #
+            # Turning play_greeting on is not the fix: queue_node_opening
+            # returns after playing the node greeting and never runs the LLM,
+            # so the introduction replaces the continuation instead of
+            # preceding it.
+            #
+            # We wait for `started`, not for `wait()`. `started` flips when the
+            # opening boundary drains at the transport, and by then the
+            # TTSSpeakFrame has passed the LLM processor, so the generation
+            # queued next lands behind it. Waiting for the speech to FINISH
+            # costs ~3 s of silence before the answer; not waiting at all
+            # risks the reverse order, because run_llm queues straight onto
+            # the LLM while the speech still has hops to go.
+            #
+            # No greeting=True on purpose: it overrides append_to_context to
+            # False, and the context commit would then depend on
+            # GreetingController -- which never fires, because tracker.greeting
+            # is a single slot and the node opening overwrites this one.
+            # mute_user still blocks interruption: it is checked before the
+            # greeting exception in should_mute_user.
+            if request.transfer_greeting and not request.play_greeting:
+                speech = await engine.queue_speech(
+                    request.transfer_greeting,
+                    append_to_context=True,
+                    persist_to_logs=False,
+                    mute_user=True,
+                )
+                for _ in range(150):      # 3 s ceiling, never blocks the call
+                    if speech.started or speech.done:
+                        break
+                    await asyncio.sleep(0.02)
             await engine.queue_node_opening(
