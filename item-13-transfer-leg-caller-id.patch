+class _ReadResponse:
+    """A Twilio response whose status and body were already read.
+
+    The retry below has to read both before it can decide whether to try again,
+    and the code that follows still expects an async context manager. Wrapping
+    the values keeps that code untouched.
+    """
+
+    def __init__(self, status, text):
+        self.status, self._text = status, text
+
+    async def text(self):
+        return self._text
+
+    async def json(self):
+        return json.loads(self._text)
+
+    async def __aenter__(self):
+        return self
+
+    async def __aexit__(self, *a):
+        return False
 
 
