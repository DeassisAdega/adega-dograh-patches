+# Handed-over turns arrive as plain "user"/"assistant" messages with nothing
+# saying WHO they were addressed to, so the destination agent reads the
+# caller's last request as its own and tries to fulfil it -- including by
+# transferring straight back. The marker goes at the END on purpose: it is the
+# last thing read before generation, and it occupies the position where the
+# inherited foreign-language turn used to sit.
+#
+# This is a workaround. The real fix is for the snapshot to carry provenance:
+# who said what, and to which agent.
+_HANDOFF_BOUNDARY = {
+    "role": "system",
+    "content": (
+        "HANDOFF BOUNDARY. Everything above was spoken to a DIFFERENT agent, "
+        "before you took over this call. It is history, not a pending request. "
+        "Any language change asked for above HAS ALREADY BEEN CARRIED OUT - you "
+        "are the agent they asked for, so do not act on it a second time. Your "
+        "VERY FIRST output must be speech, not a tool call: greet the caller in "
+        "your own language and carry on from where the conversation above "
+        "stopped. "
+        "AFTER that first turn this restriction is OVER. Everything the caller "
+        "says to you from then on is NEW, and your normal rules apply to it in "
+        "full - including a fresh request to be served in another language, "
+        "which you honour by calling the transfer tool exactly as you would on "
+        "a call that never had a handoff. THIS MATTERS: a caller who was handed "
+        "to you and then asks, in the other language, for that other language, "
+        "is making a new request, not repeating the old one."
+    ),
+}
+
+
+def _with_boundary(messages):
+    """The inherited list, with the handoff boundary marked at the end."""
+    if not messages:
+        return messages
+    return [*messages, dict(_HANDOFF_BOUNDARY)]
+
+
